<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build" ToolsVersion="4.0">
    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <OutDir Condition="'$(OutputPathOutDir)' == ''">$(MSBuildProjectDirectory)\..</OutDir>
        <MSBuildShareNuGetExe>$(MSBuildProjectDirectory)\..\..\.nuget\nuget.exe</MSBuildShareNuGetExe>
        <NuSpecFile>$(MSBuildProjectDirectory)\EPiServer.ConnectForSharePoint.nuspec</NuSpecFile>
    </PropertyGroup>
    
    <!--<Import Project="$(MSBuildProjectDirectory)\..\EPiServer.AddOns.Common.targets" Condition="'$(CommonTargetsImported)' == ''" />-->    <!-- Import shared common targets -->

    
    <Target Name="BuildSolution">
        <MSBuild Projects="$(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint.sln" Properties="Configuration=$(Configuration);" Targets="Rebuild" />
    </Target>

    <Target Name="BuildPackage">
        <!-- Build groups of the actual content of the site
            Note: Need to define these items inside this target in order to evaluate the compiled .less -> .css files -->
        <ItemGroup>
            <ConfigFiles Include="$(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\**\module.config;
                                  $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\**\ConnectForSharePoint.config" />

            <BinFiles Include="$(OutDir)\**\EPiServer.ConnectForSharePoint.dll" />

            <ClientResources Include="$(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\ClientResources\**\*.js;
                                      $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\ClientResources\**\*.css;
                                      $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\ClientResources\**\*.png;
                                      $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\ClientResources\**\*.swf;
                                      $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\ClientResources\**\*.ascx;
                                      $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\ClientResources\**\*.gif" />

            <ViewFiles Include="$(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\**\*.as?x;
                                $(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\**\*.master" />

            <LanguageFiles Include="$(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\EmbeddedLangFiles\*.xml" />
        </ItemGroup>
        
        <!--<GetVersion FilePath="$(MSBuildProjectDirectory)\..\AssemblyVersion.cs">
            <Output TaskParameter="VersionString" PropertyName="VersionString" />
        </GetVersion>-->
        

        <!-- Create a "master copy" in the InstallerSource folder -->
        <Copy SourceFiles="@(ConfigFiles)" DestinationFiles="@(ConfigFiles -> '$(InstallerSourcePath)\Content\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(BinFiles)" DestinationFiles="@(BinFiles -> '$(InstallerSourcePath)\Lib\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(LanguageFiles)" DestinationFiles="@(LanguageFiles -> '$(InstallerSourcePath)\Content\EmbeddedLangFiles\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(ViewFiles)" DestinationFiles="@(ViewFiles -> '$(InstallerSourcePath)\Content\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />

        <!--These files s hould be in versioned folder for each build-->
        <Copy SourceFiles="@(ClientResources)" DestinationFiles="@(ClientResources -> '$(InstallerSourcePath)\Content\$(VersionString)\ClientResources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />

        <MakeDir Condition="!Exists('$(OutDir)')" Directories="$(OutDir)" />

        <!-- Replace the place holder {VersionString} in nuspec and config file with actual value $(VersionString)-->
        <!--<ReplaceInFile File="$(MSBuildProjectDirectory)\EPiServer.ConnectForSharePoint.nuspec"
           Replace="{VersionString}=$(VersionString)"
           TargetFile="$(NuSpecFile)" />
        <ReplaceInFile File="$(MSBuildProjectDirectory)\..\EPiServer.ConnectForSharePoint\module.config"
           Replace="{VersionString}=$(VersionString)"
           TargetFile="$(InstallerSourcePath)\Content\module.config" />-->

        <!-- Do the actual nuget packaging -->
        <Exec Command="&quot;$(MSBuildShareNuGetExe)&quot; pack &quot;$(NuSpecFile)&quot; -BasePath &quot;$(InstallerSourcePath)&quot; -OutputDirectory &quot;$(OutDir)&quot;" />
    </Target>

    <!-- ========== main default target, default entry point ========== -->
    <Target Name="Build" DependsOnTargets="BuildSolution;BuildPackage" />    <!-- Do not need to depend on "BuildLessFiles" target because it is already executed on BeforeBuild -->
    
</Project>