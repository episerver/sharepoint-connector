<?xml version="1.0"?>
<package>
    <metadata>
        <id>EPiServer.ConnectForSharePoint</id>
        <version>2.0.0.9000</version>
        <title>EPiServer Connect For SharePoint</title>
        <authors>EPiServer</authors>
        <owners>EPiServer</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Integrate EPiServer site with SharePoint</description>
        <copyright>Copyright EPiServer 2015</copyright>
        <releaseNotes>
            Changes in  for CMS 9:
            --- Media and Custom list support
            --- Asyncronous import of items for large list support
            --- Support SharePoint 2013, SharePoint Foundation 2013, and SharePoint Online (Office 365)
			--- Overridable document injester to support custom object creation from SharePoint items
        </releaseNotes>
        <tags>EPiServerModulePackage EPiServerBetaAddon EPiServer SharePoint Connector</tags>
        <dependencies>
            <dependency id="EPiServer.CMS.Core" version="[9.0.3,10)" />
			<dependency id="EPiServer.CMS.UI" version="[9.2,10)" />
        </dependencies>
    </metadata>
</package>
