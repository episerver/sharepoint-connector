<?xml version="1.0"?>
<package>
    <metadata>
        <id>EPiServer.ConnectForSharePoint</id>
        <version>1.3.1.8000</version>
        <title>EPiServer Connect For SharePoint</title>
        <authors>EPiServer</authors>
        <owners>EPiServer</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Integrate EPiServer site with SharePoint</description>
        <copyright>Copyright EPiServer 2014 - 2015</copyright>
        <releaseNotes>
            Changes in  for CMS 8:
            --- Using REST services to avoid dependency to Microsoft Sharepoint Client DLL.
            --- Simple integration to bring Media from SharePoint to EPiServer site.
            --- Work on Azure site.
            --- Support SharePoint 2013, SharePoint Foundation 2013, and SharePoint Online (Office 365).
            --- Integrate with Content ID Mapping Service of EPiServer Framework.
        </releaseNotes>
        <tags>EPiServerModulePackage EPiServerBetaAddon EPiServer SharePoint Connector</tags>
        <dependencies>
            <dependency id="EPiServer.CMS.Core" version="[8,9)" />
        </dependencies>
    </metadata>
</package>
