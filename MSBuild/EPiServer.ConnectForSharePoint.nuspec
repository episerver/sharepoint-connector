<?xml version="1.0"?>
<package>
    <metadata>
        <id>EPiServer.ConnectForSharePoint</id>
        <version>2.0.3.9000</version>
        <title>EPiServer Connect For SharePoint</title>
        <authors>EPiServer</authors>
        <owners>EPiServer</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Integrate EPiServer site with SharePoint</description>
        <copyright>Copyright EPiServer 2015</copyright>
        <releaseNotes>
			Changes for CMS 9
				•	Media and Custom list support.
				•	Asynchronous import of items for large list support.
				•	Supports SharePoint 2013, SharePoint Foundation 2013, and SharePoint Online (Office 365).
				•	Developer access to override the default document processor to support custom object creation from SharePoint items.
        </releaseNotes>
        <tags>EPiServerModulePackage EPiServer SharePoint Connector</tags>
        <dependencies>
            <dependency id="EPiServer.CMS.Core" version="[9.0.3,10)" />
			<dependency id="EPiServer.CMS.UI" version="[9.2,10)" />
			<dependency id="EPiServer.Logging.Log4Net" version="[2,3)" />
        </dependencies>
    </metadata>
</package>
